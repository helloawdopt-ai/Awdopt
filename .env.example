# Copy to .env.local and fill in. Names only here; never commit values.
# Public (NEXT_PUBLIC_*) values are safe to expose. Everything else is a secret.

# Site origin, e.g. https://example.com (used for metadata and private links)
NEXT_PUBLIC_SITE_URL=
# Supabase project URL (awdopt-dev locally and in Preview, awdopt-prod in Production)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key, safe in the browser because RLS denies by default
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Supabase secret (service-role) key, used only in src/lib/server/*
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET. Cloudflare Turnstile secret key, verified on the server
TURNSTILE_SECRET_KEY=
# SECRET. Random salt for hashing IPs in rate limits (raw IPs are never stored)
RATE_LIMIT_IP_SALT=
# SECRET. Optional, local only: lets `npm run lhci` open protected Vercel preview URLs
VERCEL_AUTOMATION_BYPASS_SECRET=
